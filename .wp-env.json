{
    "core": "WordPress/WordPress",
    "config": {
        "WP_ENVIRONMENT_TYPE": "production",
        "WP_ENV": "production",
        "WP_DEBUG": true,
        "WP_DEBUG_LOG": true,
        "WP_DEBUG_DISPLAY": true
    },
    "mappings": {
        "wp-content/plugins/rollbar": "./"
